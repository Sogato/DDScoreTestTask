[run]
source = .
omit =
    */venv/*
    */migrations/*
    */tests.py
    */test_*.py
    */settings/*
    manage.py
    */wsgi.py
    */asgi.py
    */conftest.py
    */__pycache__/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:

[html]
directory = htmlcov